{"_about": "Multi-element + alternative-estimator CF-LIBS regression fixtures for CF-LIBS-improved, generated by the Float mirror of the verified CflibsFormal spec (oracle/Generate.lean). Each check instantiates a PROVEN theorem; see oracle/README.md. Dimensionless inputs; tolerance ~1e-6.", "global": {"kB": 1.0, "T": 1.0, "Fcal": 1.0}, "scenarios": [{"name": "ternary alloy \u2014 3 chemically-distinct elements, distinct atomic data + partition functions, 4 lines each; classic + OLS + self-absorbed estimators", "kind": "multi-element-composition", "true_composition": [0.5, 0.3, 0.2], "elements": [{"sym": "El-A", "g": [2.0, 4.0, 6.0, 8.0], "E": [0.0, 1.2, 2.5, 3.8], "A": [1.0, 0.7, 0.5, 0.3], "N": 5.0, "u": 0, "tau": 0.5, "partitionFunction": 3.876253014, "intensities": [2.579810957, 1.087833779, 0.317645668, 0.069254835]}, {"sym": "El-B", "g": [1.0, 3.0, 5.0, 7.0], "E": [0.0, 0.9, 2.1, 3.3], "A": [0.9, 0.6, 0.4, 0.2], "N": 3.0, "u": 1, "tau": 1.0, "partitionFunction": 3.090173292, "intensities": [0.873737407, 0.710470241, 0.237766138, 0.050129649]}, {"sym": "El-C", "g": [3.0, 5.0, 7.0, 9.0], "E": [0.0, 1.5, 2.8, 4.0], "A": [0.8, 0.5, 0.35, 0.25], "N": 2.0, "u": 2, "tau": 1.5, "partitionFunction": 4.706161989, "intensities": [1.019939392, 0.237061708, 0.063314715, 0.017513289]}], "checks": {"forward": {"theorem": "ForwardMap.lineIntensity / boltzmann_plot_intensity", "must": "lineIntensity(element.g,E,A, N, k) == element.intensities[k]"}, "round_trip": {"theorem": "Classic.classicDensity_recovers / classic_sound", "true_densities": [5.0, 3.0, 2.0], "recovered_densities": [999.0, 999.0, 999.0], "must": "classicDensity(lineIntensity(N)) == N per element (own U_s)"}, "temperature": {"theorem": "Classic.classic_temperature_correct", "true_T": [1.0, 1.0, 1.0], "recovered_T": [42.0, 42.0, 42.0], "must": "2-line Boltzmann slope recovers T per element"}, "ols": {"theorem": "Alt.olsDensity_recovers / leastSquares_sound / leastSquares_agrees_classic", "ols_densities": [-1.0, -1.0, -1.0], "ols_composition": [0.9, 0.9, 0.9], "must": "OLS over ALL lines recovers N per element AND ols_composition == true composition (agrees with classic)"}, "self_absorbed": {"theorem": "Alt.selfAbsorbed_sound", "self_absorbed_composition": [7.0, 7.0, 7.0], "must": "from optically-thick intensities (thin*SA(tau)) + known tau, the corrected estimator recovers the true composition"}, "closure": {"theorem": "Closure.composition_sum_one / classic_sound", "true_composition": [0.5, 0.3, 0.2], "recovered_composition": [0.0, 0.0, 0.0], "must": "recovered == true mole fractions AND sum == 1 (heterogeneous elements)"}, "calibration_free": {"theorem": "Classic.classic_calibration_free", "Fcal_scale": 1000.0, "composition_base": [1.0, 0.0, 0.0], "composition_scaled": [0.0, 0.0, 1.0], "must": "composition_scaled == composition_base (Fcal cancels)"}}}, {"name": "two-stage Saha\u2013Boltzmann \u2014 neutral + ion stages, recover T and electron density n_e", "kind": "saha-boltzmann", "constants": {"me": 1.0, "h": 1.0, "chi": 2.0}, "neutral": {"g": [2.0, 4.0, 6.0], "E": [0.0, 1.0, 2.0], "A": [1.0, 0.7, 0.4], "N": 5.0, "u": 0, "intensities": [2.334523454, 1.202352457, 0.379132071]}, "ion": {"g": [1.0, 3.0, 5.0], "E": [0.0, 1.5, 3.0], "A": [0.8, 0.5, 0.3], "N": 2.386390226, "u": 0, "intensities": [0.995197041, 0.416359641, 0.092902393]}, "checks": {"temperature": {"theorem": "Classic.classic_temperature_correct", "true_T": 1.0, "recovered_T": 77.0, "must": "neutral 2-line slope recovers T"}, "saha": {"theorem": "Saha.electronDensityFromRatio / saha_relation / electronDensity_antitone / SahaInverse.saha_joint_identifiability", "true_ne": 4.0, "recovered_ne": 123.0, "sahaFactor": 1.909112181, "stage_ratio": 0.477278045, "must": "recover Nz and Nz1 from forward intensities; R = Nz1/Nz; ne = S(T)/R == true ne; and R*ne == S(T) (Saha law)"}}}, {"name": "error-budget thresholds \u2014 min energy spread, min SNR, and the temperature / composition budgets DERIVED from the proven error-propagation chain", "kind": "error-budget", "inputs": {"tauBeta": 0.05, "snr": 0.02, "n": 6.0, "ssE": 8.0, "kB": 1.0, "T": 1.0, "relTtarget": 0.03, "tauC": 0.01, "Shat": 10.0, "card": 3.0, "vPerLine": 1.5}, "thresholds": {"requiredEnergySpread": 0.96, "maxPerLineError": 0.057735027, "requiredMinLinesStat": 0.106666667, "slopeTargetFromTempRel": 0.03, "densityBudgetFromComposition": 0.025, "noiseGain": 0.125}, "checks": {"energy_spread_tight": {"theorem": "ErrorBudget.requiredEnergySpread_sufficient", "bound_at_threshold": 0.05, "tauBeta": 0.05, "must": "slopeErrorBound(snr, n, requiredEnergySpread(tauBeta,snr,n)) == tauBeta (threshold is tight)"}, "snr_tight": {"theorem": "ErrorBudget.maxPerLineError_sufficient", "bound_at_threshold": 0.05, "tauBeta": 0.05, "must": "slopeErrorBound(maxPerLineError(tauBeta,n,ssE), n, ssE) == tauBeta (threshold is tight)"}, "noise_gain": {"theorem": "ErrorBudget.olsSlope_noise_gain", "noiseGain": 0.125, "ssE": 8.0, "must": "noiseGain == 1/ssE (Gauss-Markov slope-variance multiplier)"}, "temp_rel": {"theorem": "ErrorBudget.temp_rel_error_eq", "slopeTarget": 0.03, "relTtarget": 0.03, "must": "slopeTargetFromTempRel(relTtarget,kB,T) * (kB*T) == relTtarget (exact)"}, "composition_budget": {"theorem": "ErrorBudget.composition_target_sufficient", "densityBudget": 0.025, "tauC": 0.01, "Shat": 10.0, "card": 3.0, "must": "(card+1)*densityBudgetFromComposition(tauC,Shat,card) == tauC*Shat (budget saturates the target)"}}}, {"name": "energy/wavelength ordinate \u2014 one element through the energy forward map with DISTINCT per-line lambda; proves the wavelength (ln(I*lambda/gA)) and photon-rate (ln(I/gA)) conventions agree", "kind": "energy-ordinate", "constants": {"hc": 2.0, "fourPi": 4.0, "Fgeo": 1.5}, "element": {"g": [2.0, 4.0, 6.0, 8.0], "E": [0.0, 1.2, 2.5, 3.8], "A": [1.0, 0.7, 0.5, 0.3], "lambda": [3.0, 2.6, 2.1, 1.7], "N": 5.0, "intensities": [0.644952739, 0.313798206, 0.113444882, 0.030553604]}, "checks": {"forward": {"theorem": "ForwardMapEnergy.lineIntensityEnergy", "must": "lineIntensityEnergy(hc,4pi,N,Fgeo, g,E,A,lambda, k) == element.intensities[k]"}, "reduction": {"theorem": "ForwardMapEnergy.lineIntensityEnergy_eq_lineIntensity", "must": "lineIntensityEnergy[k] == lineIntensity(Fcal = hc*Fgeo/(4pi*lambda[k]))[k] (per-line Fcal reduction)"}, "mul_lam": {"theorem": "ForwardMapEnergy.lineIntensityEnergy_mul_lam", "must": "lineIntensityEnergy[k] * lambda[k] == lineIntensity(Fcal = hc*Fgeo/(4pi))[k] (lambda cancels the 1/lambda photon-energy factor)"}, "temperature": {"theorem": "ForwardMapEnergy.temperature_from_two_lines_wavelength", "true_T": 1.0, "must": "2-line slope of the wavelength ordinate ln(I*lambda/(g*A)) recovers T (distinct per-line lambda; lambda cancels)"}}}, {"name": "Stark broadening n_e diagnostic + McWhirter LTE bound -- dimensionless Griem linear width inverse (n_e = nRef*width/(2w)) and the sqrt(T)*dE^3 McWhirter shape", "kind": "stark", "constants": {"w": 0.05, "nRef": 1.0, "width": 0.3, "T": 4.0, "dE": 2.0}, "checks": {"stark_density": {"theorem": "StarkBroadening.starkDensity_recovers", "ne": 3.0, "must": "starkDensity(w,nRef,width) == nRef*width/(2w) == ne (Griem linear n_e diagnostic); pipeline estimate_ne_from_stark(width, REF_T_K, stark_w_ref=2w) == REF_NE*ne/nRef"}, "stark_roundtrip": {"theorem": "StarkBroadening.starkFWHM / starkDensity_recovers", "width_roundtrip": 0.3, "must": "starkFWHM(w,nRef, starkDensity(w,nRef,width)) == width (forward/inverse round trip)"}, "mcwhirter": {"theorem": "StarkBroadening.mcWhirterBound", "shape": 16.0, "must": "mcWhirterShape(T,dE) == sqrt(T)*dE^3 == shape; full McWhirter LTE bound = 1.6e12 * shape (pipeline MCWHIRTER_CONST)"}}}, {"name": "runtime certificates \u2014 the 12 predicates of CflibsFormal/Certificates.lean (the typed bridge, dossier 12 M3), each on its non-vacuity witness plus the reference mirror's rejection tests", "kind": "certificates", "certificates": [{"id": "C1", "name": "energy_spread", "theorem": "designNormalMatrix_det_ne_zero_iff", "predicate": "0 < SSe", "inputs": {"E": [0.0, 1.0]}, "verdict": true, "value": 0.5}, {"id": "C2", "name": "joint_rank", "theorem": "jointDesign_det_pos_iff", "predicate": "0 < SSe*SSs - S_Es^2", "inputs": {"E": [0.0, 1.0, 2.0], "s": [0.0, 0.0, 1.0]}, "verdict": true, "value": 0.333333333}, {"id": "C3", "name": "conditioning", "theorem": "boltzmannConditionNumber_ge_one", "predicate": "0 < SSe", "inputs": {"E": [0.0, 1.0]}, "verdict": true, "value": 0.5}, {"id": "C4", "name": "slope_budget", "theorem": "maxPerLineError_sufficient", "predicate": "eps^2 * n <= tauBeta^2 * SSe", "inputs": {"eps": 1.0, "tauBeta": 2.0, "SSe": 0.5, "n": 2.0}, "verdict": true, "value": 0.0}, {"id": "C5", "name": "temp_budget", "theorem": "temp_rel_error_le", "predicate": "kB * THat * B <= tauT", "inputs": {"kB": 1.0, "THat": 2.0, "B": 0.5, "tauT": 1.0}, "verdict": true, "value": 0.0}, {"id": "C6", "name": "comp_budget", "theorem": "composition_target_sufficient", "predicate": "(n+1)*delta <= tauC*Shat", "inputs": {"delta": 1.0, "tauC": 2.0, "Shat": 2.0, "n": 2.0}, "verdict": true, "value": 1.0}, {"id": "C7", "name": "mcwhirter", "theorem": "mcwhirter_iff_thermalizationLimit", "predicate": "C * sqrt(T) * dE^3 <= ne", "inputs": {"C": 1.0, "T": 1.0, "dE": 1.0, "ne": 2.0}, "verdict": true, "value": 1.0}, {"id": "C9", "name": "saha_iter", "theorem": "sahaIter_tendsto", "predicate": "b < Ntot & sahaEquilibriumNe(S,Ntot) <= b & sqrt(S)/(2 sqrt(Ntot-b)) < 1 & sqrt(S*Ntot) <= b", "inputs": {"S": 1.0, "Ntot": 3.0, "b": 2.0}, "verdict": true, "value": 0.5}, {"id": "C10", "name": "damped_iter", "theorem": "dampedMultiElementIter_tendsto", "predicate": "(all s, S[s] > 0) & (all s, Ntot[s] > 0)", "inputs": {"S": [1.0, 1.0], "Ntot": [1.0, 1.0]}, "verdict": true, "value": 0.666666667}, {"id": "C12", "name": "known_tau", "theorem": "lineIntensity_eq_selfAbsorbedIntensity_div", "predicate": "0 <= tau", "inputs": {"tau": 1.0}, "verdict": true, "value": 1.0}, {"id": "C13", "name": "sa_distinct", "theorem": "cogRatio_injOn", "predicate": "0 < w2 & w2 < w1", "inputs": {"w1": 2.0, "w2": 1.0}, "verdict": true, "value": 1.0}, {"id": "C14", "name": "alias_budget", "theorem": "classicDensity_aliasing_error", "predicate": "0 <= delta & delta < 1", "inputs": {"delta": 0.5}, "verdict": true, "value": 1.0}, {"id": "C1", "name": "energy_spread (reject: flat energies)", "theorem": "designNormalMatrix_det_ne_zero_iff", "predicate": "0 < SSe", "inputs": {"E": [1.0, 1.0]}, "verdict": false, "value": 0.0}, {"id": "C2", "name": "joint_rank (reject: collinear E,s)", "theorem": "jointDesign_det_pos_iff", "predicate": "0 < SSe*SSs - S_Es^2", "inputs": {"E": [0.0, 1.0], "s": [0.0, 2.0]}, "verdict": false, "value": 0.0}, {"id": "C10", "name": "damped_iter (reject: nonpositive S)", "theorem": "dampedMultiElementIter_tendsto", "predicate": "(all s, S[s] > 0) & (all s, Ntot[s] > 0)", "inputs": {"S": [0.0, 1.0], "Ntot": [1.0, 1.0]}, "verdict": false, "value": 0.0}, {"id": "C14", "name": "alias_budget (reject: delta = 1)", "theorem": "classicDensity_aliasing_error", "predicate": "0 <= delta & delta < 1", "inputs": {"delta": 1.0}, "verdict": false, "value": 0.0}]}]}